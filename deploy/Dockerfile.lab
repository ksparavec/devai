# Layer 2: All packages + configuration (rebuild when packages change)

ARG BASE_IMAGE=devai-base-cpu
FROM ${BASE_IMAGE}

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG GPU_BUILD=false
ARG OLLAMA_HOST=http://devai-router:11434
ARG OLLAMA_DEFAULT_MODEL=qwen3.5:9b

ENV OLLAMA_HOST=${OLLAMA_HOST}
ENV OLLAMA_URL=${OLLAMA_HOST}
ENV OLLAMA_API_BASE=${OLLAMA_HOST}
ENV OLLAMA_DEFAULT_MODEL=${OLLAMA_DEFAULT_MODEL}
# CLI local model defaults via Ollama router (override at runtime with real API keys for cloud use)
ENV ANTHROPIC_BASE_URL=${OLLAMA_HOST}
ENV ANTHROPIC_AUTH_TOKEN=ollama
ENV ANTHROPIC_API_KEY=""
ENV UV_BREAK_SYSTEM_PACKAGES=1
ENV PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1
ENV PATH="/home/devai/.local/bin:${PATH}"

# --- Dependencies for coding agents ---
RUN apt-get update && apt-get install -y --no-install-recommends ripgrep fzf \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# --- Binary installs (from local cache, populated by: make fetch) ---

# Cache-bust when binaries change (hash computed by Makefile)
ARG BIN_HASH=unknown
# Install CLI binaries (pre-downloaded to /var/cache/bin/ via cache mount)
RUN cp /var/cache/bin/uv /var/cache/bin/uvx /var/cache/bin/claude /var/cache/bin/codex /var/cache/bin/ollama /usr/local/bin/ \
    && chmod +x /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/claude /usr/local/bin/codex /usr/local/bin/ollama

# Install code-server (pre-downloaded)
RUN cp -a /var/cache/bin/code-server /usr/local/lib/code-server \
    && ln -s /usr/local/lib/code-server/bin/code-server /usr/local/bin/code-server

# Install Gemini CLI (pre-installed by: make fetch)
RUN cp -a /var/cache/bin/gemini/lib/node_modules/@google /usr/local/lib/node_modules/ \
    && ln -sf ../lib/node_modules/@google/gemini-cli/bundle/gemini.js /usr/local/bin/gemini

# --- Package installs (change more often, cached after binaries) ---
# All Python packages in a single resolve to avoid version conflicts.
# Host cache dirs are bind-mounted via -v at build time (see Makefile).

COPY requirements-base.txt /tmp/requirements-base.txt
RUN if [ "$GPU_BUILD" = "true" ]; then \
        TORCH_ARGS="torch torchvision torchaudio"; \
    else \
        TORCH_ARGS="torch torchvision torchaudio --extra-index-url https://download.pytorch.org/whl/cpu"; \
    fi \
    && uv pip install --system \
        $TORCH_ARGS \
        -r /tmp/requirements-base.txt

# Optional project-specific dependencies (create requirements.txt to use)
RUN --mount=type=bind,source=.,target=/src \
    if [ -f /src/requirements.txt ]; then \
        uv pip install --system -r /src/requirements.txt; \
    fi


# Install Aider in isolated venv (requires Python <3.13, uv tool handles this)
RUN UV_TOOL_BIN_DIR=/usr/local/bin uv tool install aider-chat

# --- JupyterLab extension (depends on jupyterlab being installed above) ---

# Install JupyterLab AI launcher extension (pre-built)
COPY packages/jupyter-ai-launchers/jupyter_ai_launchers/labextension /usr/local/share/jupyter/labextensions/jupyter-ai-launchers

# --- Runtime setup ---

# Install wrapper scripts for JupyterLab launchers and shell picker
COPY scripts/ollama-chat.sh /usr/local/bin/ollama-chat
COPY scripts/aider-launcher.sh /usr/local/bin/aider-launcher
COPY scripts/agent-picker.sh /usr/local/bin/agent-picker
COPY scripts/model-picker.py /usr/local/bin/model-picker
COPY deploy/models.yaml /etc/devai/models.yaml
RUN chmod +x /usr/local/bin/ollama-chat /usr/local/bin/aider-launcher /usr/local/bin/agent-picker /usr/local/bin/model-picker

# Create user and directories (handle GID/UID conflicts in GPU base images)
RUN getent group 1000 >/dev/null || groupadd -g 1000 devai \
    && id -u 1000 >/dev/null 2>&1 || useradd -u 1000 -g 1000 -m -s /bin/bash devai \
    && mkdir -p /home/devai/work /home/devai/.local/bin \
    && ln -s /usr/local/bin/claude /home/devai/.local/bin/claude \
    && ln -s /usr/local/bin/codex /home/devai/.local/bin/codex \
    && ln -s /usr/local/bin/gemini /home/devai/.local/bin/gemini \
    && ln -s /usr/local/bin/ollama /home/devai/.local/bin/ollama \
    && ln -s /usr/local/bin/code-server /home/devai/.local/bin/code-server \
    && chown -R 1000:1000 /home/devai

# Seed config files for coding agents (copied to $HOME by entrypoint if absent)
COPY config/codex/config.toml /etc/devai/codex-config.toml

# Copy entrypoint script
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 8888

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root"]
