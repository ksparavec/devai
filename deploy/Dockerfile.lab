# Layer 2: All packages + configuration (rebuild when packages change)

ARG BASE_IMAGE=devai-base-cpu
FROM ${BASE_IMAGE}

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG GPU_BUILD=false
# Separate from GPU_BUILD ("is this a GPU build at all"): which vendor's
# wheel index to use when it is. See docs/gpu-vendors.md.
ARG GPU_VENDOR=nvidia
ARG OLLAMA_HOST=http://devai-router:11434
ARG OLLAMA_DEFAULT_MODEL=qwen3.5:9b

ENV OLLAMA_HOST=${OLLAMA_HOST}
ENV OLLAMA_URL=${OLLAMA_HOST}
ENV OLLAMA_API_BASE=${OLLAMA_HOST}
ENV OLLAMA_DEFAULT_MODEL=${OLLAMA_DEFAULT_MODEL}
# CLI local model defaults via Ollama router (override at runtime with real API keys for cloud use)
ENV ANTHROPIC_BASE_URL=${OLLAMA_HOST}
ENV ANTHROPIC_AUTH_TOKEN=ollama
ENV ANTHROPIC_API_KEY=""
# The image ships claude at /usr/local/bin/claude (on PATH). Claude Code's
# auto-updater otherwise runs migrate-installer on first launch and drops a
# versioned copy into ~/.local/bin/claude -- which, because ~ is the persistent
# home volume appended LAST on PATH (see below), no longer shadows the baked
# binary, but would still pin a stale copy if invoked directly. Disable it so
# the baked, reproducible version is always what runs.
ENV DISABLE_AUTOUPDATER=1
# Codex reads config from $CODEX_HOME (default ~/.codex). Pin it to the
# devai user's home so codex finds the entrypoint-seeded config.toml
# regardless of the runtime user (root or devai) and without per-shell
# tweaks. OPENAI_API_KEY is required for codex's OSS path; local backends
# don't validate it.
ENV CODEX_HOME=/home/devai/.codex
ENV OPENAI_API_KEY=local
# Enable opencode's built-in Exa-backed web SEARCH tool (no API key; calls Exa's
# hosted endpoint, which egresses through pipelock and is inspected). Without
# this, opencode has only webfetch (specific URLs) and the model resorts to
# guessing URLs. opencode reads this env var at startup.
ENV OPENCODE_ENABLE_EXA=1
ENV UV_BREAK_SYSTEM_PACKAGES=1
ENV PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1
# Append (not prepend) ~/.local/bin: it lives on the persistent home volume, so
# a file dropped there at runtime (auto-updater, `pip install --user`, ...) must
# NOT be able to shadow the image's baked /usr/local/bin tools. Kept on PATH for
# genuine user-installed CLIs, but system binaries always win.
ENV PATH="${PATH}:/home/devai/.local/bin"

# --- Dependencies for coding agents ---
# libxcb1 was here only for Open Interpreter, which imported cv2 at startup
# and pulled in X11 client libs even headless. Open Interpreter was removed
# from the project on 2026-07-28 (dead in this image on modern setuptools,
# and abandoned upstream), so the dependency went with it.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ripgrep fzf ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# --- pipelock MITM CA trust (egress fail-closed; see docs/pipelock.md) ---
# The lab egresses ONLY through the pipelock proxy, which presents per-host
# leaf certs signed by this CA. Bake the CA into the system trust store so
# curl / git / pip / uv / node validate transparently. deploy/pipelock-ca.crt
# is the operator's CA public cert -- regenerate it for a real deployment with
# `make pipelock-ca-init` (the shipped default's private key is intentionally
# not distributed). Proxy env (HTTPS_PROXY/NO_PROXY) is injected at RUNTIME by
# bin/devai-agent and the make lab/shell targets, not baked here.
COPY deploy/pipelock-ca.crt /usr/local/share/ca-certificates/pipelock-ca.crt
RUN update-ca-certificates
ENV NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/pipelock-ca.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt \
    PIP_CERT=/etc/ssl/certs/ca-certificates.crt

# --- Binary installs (from local cache, populated by: make fetch) ---

# Cache-bust when binaries change (hash computed by Makefile).
# BIN_HASH MUST be referenced inside the RUN below (not just declared) or the
# layer cache is never invalidated: podman only busts a RUN's cache when a
# build-arg it actually uses changes. Without the `echo "$BIN_HASH"`, a changed
# bundle (e.g. an aiagent release bump) silently reuses the stale binary-install
# layer, and every layer downstream (code-server, gemini, aiagent) with it.
ARG BIN_HASH=unknown
# Install CLI binaries (pre-downloaded to /var/cache/bin/ via cache mount).
RUN echo "binary cache key: BIN_HASH=$BIN_HASH" \
    && cp /var/cache/bin/uv /var/cache/bin/uvx /var/cache/bin/claude /var/cache/bin/codex /var/cache/bin/opencode /var/cache/bin/ollama /usr/local/bin/ \
    && chmod +x /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/claude /usr/local/bin/codex /usr/local/bin/opencode /usr/local/bin/ollama

# Install code-server (pre-downloaded)
RUN cp -a /var/cache/bin/code-server /usr/local/lib/code-server \
    && ln -s /usr/local/lib/code-server/bin/code-server /usr/local/bin/code-server

# Install Gemini CLI (pre-installed by: make fetch)
RUN cp -a /var/cache/bin/gemini/lib/node_modules/@google /usr/local/lib/node_modules/ \
    && ln -sf ../lib/node_modules/@google/gemini-cli/bundle/gemini.js /usr/local/bin/gemini

# --- Package installs (change more often, cached after binaries) ---
# All Python packages in a single resolve to avoid version conflicts.
# Host cache dirs are bind-mounted via -v at build time (see Makefile).

COPY requirements-base.txt /tmp/requirements-base.txt
RUN if [ "$GPU_BUILD" = "true" ] && [ "$GPU_VENDOR" = "amd" ]; then \
        # Full index-url replacement, not --extra-index-url like the CPU
        # branch below: default PyPI would still be consulted first and
        # could resolve a CUDA wheel on an AMD host.
        TORCH_ARGS="torch torchvision torchaudio --index-url https://download.pytorch.org/whl/rocm6.4"; \
    elif [ "$GPU_BUILD" = "true" ]; then \
        TORCH_ARGS="torch torchvision torchaudio"; \
    else \
        TORCH_ARGS="torch torchvision torchaudio --extra-index-url https://download.pytorch.org/whl/cpu"; \
    fi \
    && uv pip install --system \
        $TORCH_ARGS \
        -r /tmp/requirements-base.txt

# Optional project-specific dependencies (create requirements.txt to use)
RUN --mount=type=bind,source=.,target=/src \
    if [ -f /src/requirements.txt ]; then \
        uv pip install --system -r /src/requirements.txt; \
    fi


# Install Aider in isolated venv. Python 3.13 dropped stdlib `audioop`,
# which pydub (transitively imported by aider.voice) needs — pull
# `audioop-lts` into the same venv so `import aider` doesn't crash.
RUN UV_TOOL_BIN_DIR=/usr/local/bin uv tool install aider-chat \
    --with audioop-lts

# Install SkyPilot CLI (per docs/plans/skypilot-agent-skill.md).
# Wheels pre-fetched by `make fetch-cli` into
# /var/cache/devai/pip/wheels/skypilot/ and bind-mounted at build time
# under /var/cache/wheels/skypilot. Offline install with --find-links
# keeps the build network-free, matching the existing CLI pattern.
# --no-index is REQUIRED (not just --offline): without it uv resolves
# against its cached PyPI metadata and can pick a dependency version
# (e.g. a newer fastapi) whose wheel was never pre-fetched, failing the
# build. --no-index restricts the package universe to exactly the
# wheels `make fetch-cli` downloaded -- a consistent, complete closure.
#
# The wheel directory is OPTIONAL at build time -- the lab image still
# builds without it (the `if` skips the install gracefully). Operators
# who skipped `make fetch-cli` for skypilot get a working lab without
# the `sky` binary; they can install it later via
# `uv pip install --system 'skypilot[aws,gcp,azure,kubernetes,slurm,runpod,lambda]'`.
RUN --mount=type=bind,source=.,target=/src \
    if [ -d /var/cache/wheels/skypilot ] && [ -n "$(ls -A /var/cache/wheels/skypilot 2>/dev/null)" ]; then \
        uv pip install --system --offline --no-index \
            --find-links /var/cache/wheels/skypilot \
            'skypilot[aws,gcp,azure,kubernetes,slurm,runpod,lambda]' \
        && sky --version >/dev/null 2>&1 \
        || echo "WARN: skypilot install completed but 'sky --version' failed; investigate"; \
    else \
        echo "INFO: /var/cache/wheels/skypilot empty; skipping SkyPilot install. Run 'make fetch-cli' to populate."; \
    fi

# Install aiagent (devitops-com/aiagent): a self-extracting makeself bundle that
# ships its OWN bundled CPython 3.13, used by aiagent ONLY. Installed to an
# ISOLATED prefix /opt/aiagent so aiagent's interpreter
# (/opt/aiagent/bin/python3.13) stays OFF the system PATH -- the two interpreters
# never mix: the lab's modules go to the /usr/local python via
# `uv pip install --system`, and NOTHING is ever installed into aiagent's tree.
# (Installing aiagent under /usr/local previously put its python on PATH, so
# uv --system resolved to it and bled the whole lab requirement set -- torch,
# jupyterlab, a transitive typer -- into the bundle, overwriting its pinned deps
# and breaking the CLI.) Only the `aiagent` launcher is symlinked onto PATH; the
# bundled python is never exposed. Pre-fetched by `make fetch-cli` into
# /var/cache/bin/aiagent-install.sh (bind-mounted read-only at build time).
# Optional: skip gracefully when the operator hasn't run `make fetch-cli` yet.
RUN if [ -f /var/cache/bin/aiagent-install.sh ]; then \
        AIAGENT_PREFIX=/opt/aiagent sh /var/cache/bin/aiagent-install.sh </dev/null \
        && chmod -R a+rX /opt/aiagent \
        && ln -sf /opt/aiagent/bin/aiagent /usr/local/bin/aiagent \
        && aiagent version >/dev/null 2>&1 \
        || echo "WARN: aiagent install completed but 'aiagent version' failed; investigate"; \
    else \
        echo "INFO: /var/cache/bin/aiagent-install.sh missing; skipping aiagent install. Run 'make fetch-cli' to populate."; \
    fi

# --- JupyterLab extension (depends on jupyterlab being installed above) ---

# Install JupyterLab AI launcher extension (pre-built)
COPY packages/jupyter-ai-launchers/jupyter_ai_launchers/labextension /usr/local/share/jupyter/labextensions/jupyter-ai-launchers

# --- Runtime setup ---

# Install wrapper scripts for JupyterLab launchers and shell picker
COPY scripts/ollama-chat.sh /usr/local/bin/ollama-chat
COPY scripts/aider-launcher.sh /usr/local/bin/aider-launcher
# aiagent shell launcher: the picker's "AIAgent (shell)" agent configures the
# router endpoint + model, then execs this to drop the user into an interactive
# bash shell where they run `aiagent ...` themselves. See scripts/aiagent-launcher.sh.
COPY scripts/aiagent-launcher.sh /usr/local/bin/aiagent-shell
COPY scripts/agent-picker.sh /usr/local/bin/agent-picker
COPY scripts/model-picker.py /usr/local/bin/model-picker
# SkyPilot first-launch helper. docs/skypilot-user-guide.md instructs the
# user to run /usr/local/bin/sky-setup.sh; it was never COPY'd, so that
# instruction was dead. The `sky` CLI itself is installed above.
COPY scripts/sky-setup.sh /usr/local/bin/sky-setup.sh
# Capability constants module imported by the picker at startup. Co-located
# so /usr/local/bin/ is on the resolved PYTHONPATH and a plain
# `from _capability import Capability` works without sys.path gymnastics.
# bin/devai-agent additionally bind-mounts a host copy over this for
# hot-update workflows.
COPY scripts/_capability.py /usr/local/bin/_capability.py
# Exclusion ledger reader. The picker imports it to hide (model, backend)
# rows an operator has recorded a bench verdict for. Co-located for the
# same reason as _capability, and likewise bind-mountable from the host.
# The picker treats it as OPTIONAL -- an older image without it degrades
# to showing every row rather than failing to start.
COPY scripts/_model_status.py /usr/local/bin/_model_status.py
COPY scripts/vram-fit.py /usr/local/bin/vram-fit.py
COPY deploy/models.yaml /etc/devai/models.yaml
RUN chmod +x /usr/local/bin/ollama-chat /usr/local/bin/aider-launcher /usr/local/bin/aiagent-shell /usr/local/bin/agent-picker /usr/local/bin/model-picker /usr/local/bin/sky-setup.sh

# Name the GPU 'render' group in /etc/group. On the host, /dev/dri/renderD* is
# owned by group `render` (GID 992 here); `--device nvidia.com/gpu=all` (NVIDIA
# CDI) injects that GID as a supplementary group inside the container so the GPU
# is reachable, but the base image's /etc/group has only `video` (44), leaving
# 992 nameless. Debian's /etc/bash.bashrc then runs `$(groups)` at the start of
# every interactive shell and prints "groups: cannot find name for group ID 992".
# Naming it here silences that for every agent/shell (the `video` half is already
# named by the base image). Idempotent; tune RENDER_GID for a host whose render
# group differs.
ARG RENDER_GID=992
RUN getent group "$RENDER_GID" >/dev/null 2>&1 \
    || groupadd -g "$RENDER_GID" render 2>/dev/null \
    || echo "render:x:${RENDER_GID}:" >> /etc/group

# Create the devai user/group at uid/gid 1000 with home /home/devai. The GPU base
# (nvidia/cuda:...-ubuntu2404) already ships an `ubuntu` user/group at 1000, so a
# plain `useradd devai` is skipped there and uid 1000 stays `ubuntu` -- which
# breaks `--user devai` (non-root mode) and is inconsistent with the CPU (debian)
# image. Instead, RENAME whatever occupies 1000 to `devai` (mirroring what the
# docker-path entrypoint does at runtime), so uid 1000 == devai on both bases.
RUN set -eu; \
    if getent group 1000 >/dev/null 2>&1; then \
        g="$(getent group 1000 | cut -d: -f1)"; \
        [ "$g" = devai ] || groupmod -n devai "$g"; \
    else \
        groupadd -g 1000 devai; \
    fi; \
    if getent passwd 1000 >/dev/null 2>&1; then \
        u="$(getent passwd 1000 | cut -d: -f1)"; \
        [ "$u" = devai ] || usermod -l devai "$u"; \
        usermod -g 1000 -d /home/devai -s /bin/bash -c '' devai; \
    else \
        useradd -u 1000 -g 1000 -d /home/devai -s /bin/bash devai; \
    fi; \
    mkdir -p /home/devai/work /home/devai/.local/bin; \
    chown -R 1000:1000 /home/devai

# Seed config files for coding agents (copied to $HOME by entrypoint if absent)
COPY config/codex/config.toml /etc/devai/codex-config.toml
COPY config/opencode/opencode.json /etc/devai/opencode.json

# Copy entrypoint script
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 8888

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root"]
