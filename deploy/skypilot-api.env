# Non-secret config for the SkyPilot API server (per
# docs/plans/skypilot-fleet-provisioner.md Phase 1).
#
# Read by docker-compose at startup; values flow into
# devai-skypilot-api-server's environment. Cloud credentials live in
# /run/devai/skypilot-credentials.env (rendered by
# `make skypilot-secrets-render`), NOT here.

# Host port the API server publishes. Container side stays at 46580
# (upstream default); only the host mapping is tunable.
SKYPILOT_API_PORT=46580
