# Non-secret config for the SkyPilot API server (per
# docs/plans/skypilot-fleet-provisioner.md Phase 1).
#
# REFERENCE ONLY -- nothing sources this file. SKYPILOT_API_PORT is a
# compose *substitution* variable: it is expanded while
# docker-compose.yaml is parsed (`ports:
# "127.0.0.1:${SKYPILOT_API_PORT:-46580}:46580"`), so compose can only
# pick it up from the project .env file or from the shell environment --
# never from a service-level `env_file:`, which would merely inject it
# into the running container where nothing reads it. To override the
# port, set SKYPILOT_API_PORT in .env or export it before
# `make skypilot-up`.
#
# Cloud credentials live in /run/devai/skypilot-credentials.env
# (rendered by `make skypilot-secrets-render`), NOT here.

# Host port the API server publishes. Container side stays at 46580
# (upstream default); only the host mapping is tunable.
# Published on 127.0.0.1 only: `sky api start --deploy` has no
# authentication, and /api/v1/launch spends real cloud money.
SKYPILOT_API_PORT=46580
