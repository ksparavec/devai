# Layer 1: System packages + runtimes (build once)
# CPU:  podman build -f Dockerfile.base -t devai-base .
# GPU:  podman build -f Dockerfile.base --build-arg BASE_IMAGE=docker.io/nvidia/cuda:12.9.1-cudnn-runtime-ubuntu24.04 -t devai-base-gpu .

ARG BASE_IMAGE=debian:trixie
FROM ${BASE_IMAGE}

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG PYTHON_VERSION=3.13

ENV SHELL=/bin/bash
ENV DEBIAN_FRONTEND=noninteractive

# Configure apt proxy/cache during build (cleaned up after install)
ARG APT_PROXY
RUN if [ -n "$APT_PROXY" ]; then echo "Acquire::http::Proxy \"$APT_PROXY\";" > /etc/apt/apt.conf.d/00cache; fi && \
    if [ -n "$HTTP_PROXY" ]; then echo "Acquire::http::Proxy \"$HTTP_PROXY\";" > /etc/apt/apt.conf.d/99proxy; fi && \
    if [ -n "$HTTPS_PROXY" ]; then echo "Acquire::https::Proxy \"$HTTPS_PROXY\";" >> /etc/apt/apt.conf.d/99proxy; fi

# Install system packages and compilers (no Python — installed via uv below)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    gosu \
    git \
    bubblewrap \
    build-essential \
    nvtop \
    vim \
    zstd \
    rustc \
    cargo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/apt/apt.conf.d/00cache /etc/apt/apt.conf.d/99proxy

# Install uv (Python package manager)
RUN curl -fsSL https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /root/.local/bin/uvx /usr/local/bin/

# Install Python via uv (latest patch of PYTHON_VERSION, e.g. 3.13 -> 3.13.x)
# uv creates /usr/local/python/cpython-X.Y.Z-<platform>/ — symlink to /usr/local/python/current
ENV UV_PYTHON_INSTALL_DIR=/usr/local/python
ENV PATH="/usr/local/python/current/bin:${PATH}"
RUN uv python install $PYTHON_VERSION \
    && PYBIN=$(dirname "$(uv python find $PYTHON_VERSION)") \
    && ln -s "$(dirname "$PYBIN")" /usr/local/python/current \
    && ln -sf python3 "$PYBIN/python" \
    && python --version

# Install Node.js 22 LTS (binary tarball) -> /usr/local/bin/node, /usr/local/bin/npm
RUN NODE_VERSION=22.16.0 \
    && ARCH=$(dpkg --print-architecture) \
    && case "$ARCH" in amd64) NODE_ARCH=x64;; arm64) NODE_ARCH=arm64;; *) echo "Unsupported arch: $ARCH" && exit 1;; esac \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
       | tar -xJ --strip-components=1 -C /usr/local \
    && rm -rf /usr/local/CHANGELOG.md /usr/local/README.md /usr/local/LICENSE

# Verify all tools are on PATH
RUN python --version && node --version && npm --version
