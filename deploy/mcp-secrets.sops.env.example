# Plaintext template for deploy/mcp-secrets.sops.env.
#
# To use:
#   1. cp deploy/mcp-secrets.sops.env.example /tmp/mcp.env
#   2. fill in real values (umask 077 first!)
#   3. sops --encrypt /tmp/mcp.env > deploy/mcp-secrets.sops.env
#   4. shred -u /tmp/mcp.env
#   5. git add deploy/mcp-secrets.sops.env
#
# Per docs/plans/mcp-gateway.md Phase 2 + docs/secrets.md.
#
# This template file is shipped as plaintext so operators can see
# the expected variable names without decrypting anything. Real
# .sops.env files are encrypted at rest -- never commit a plaintext
# version under the canonical name.

GITHUB_TOKEN=ghp_replace_with_real_token
FIRECRAWL_API_KEY=fc-replace_with_real_key
HF_TOKEN=hf_replace_with_real_token
CONTEXT7_API_KEY=ctx_replace_with_real_key
