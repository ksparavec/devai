# Plaintext template for deploy/skypilot-credentials.sops.env.
#
# To use:
#   1. cp deploy/skypilot-credentials.sops.env.example /tmp/sky-creds.env
#   2. fill in real values (umask 077 first!)
#   3. sops --encrypt /tmp/sky-creds.env > deploy/skypilot-credentials.sops.env
#   4. shred -u /tmp/sky-creds.env
#   5. git add deploy/skypilot-credentials.sops.env
#
# Per docs/plans/skypilot-fleet-provisioner.md Phase 1 + docs/secrets.md.
#
# These are the non-interactive cloud credentials the SkyPilot API
# server needs when there is no $HOME mount with the operator's
# personal ~/.aws or ~/.config/gcloud (e.g. when running in a
# multi-user devai head deployment). Comment out any cloud you don't
# use; SkyPilot's `sky check` will report which clouds it sees.

# RunPod -- cheapest 3090 / 4090 spot capacity. Get from:
# https://runpod.io/console/user/settings -> API Keys
RUNPOD_API_KEY=replace_with_real_key

# Lambda Labs -- on-demand A100 / H100 capacity. Get from:
# https://cloud.lambdalabs.com/api-keys
LAMBDA_API_KEY=replace_with_real_key

# Bearer token for the gpu-arbiter <-> SkyPilot API server channel
# (see skypilot-fleet-provisioner.md decision 3). Generate with:
#   openssl rand -base64 32
SKYPILOT_API_TOKEN=replace_with_real_token
