# Non-secret config for the MCP gateway (per docs/plans/mcp-gateway.md).
#
# REFERENCE ONLY -- nothing sources this file. MCP_PORT is a compose
# *substitution* variable: it is expanded while docker-compose.yaml is
# parsed (`ports: "127.0.0.1:${MCP_PORT:-8088}:8088"`), so compose can
# only pick it up from the project .env file or from the shell
# environment -- never from a service-level `env_file:`, which would
# merely inject it into the running container where nothing reads it.
# To override the port, set MCP_PORT in .env or export it before
# `make mcp-up`.
#
# Tier 2 secrets live in /run/devai/mcp-secrets.env (rendered by
# `make mcp-secrets-render`, bind-mounted to /secrets/.env), NOT here.

# Host port the gateway listens on (override of the proposed 11437 to
# move MCP off the 1143X model-backend cluster). Per decision 2.
# Published on 127.0.0.1 only: the gateway holds a read-write podman
# socket, so reaching it is equivalent to container-create as the
# invoking user (uid 1000 under rootless podman -- not host root, but
# still everything that user owns). See docs/mcp.md "Security model".
MCP_PORT=8088

# Container port the gateway binds inside its own namespace. Constant
# unless the upstream image changes -- the host:container mapping in
# docker-compose.yaml uses MCP_PORT for the host side and 8088 for the
# container side.
# (No env var here: container side is hardcoded in compose to keep
# the Phase 2 secret-mount path stable across MCP_PORT overrides.)
