[Unit]
Description=DevAI Infrastructure (caches + Ollama + router)
Requires=podman.socket
After=podman.socket

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=%h/.config/devai
# The router mounts ${DEVAI_REPO}/deploy (plan I25) and compose refuses to
# start without it. `make install-systemd` replaces the placeholder with the
# repository's absolute path when it installs this unit, escaped for a
# quoted value (\ and " backslashed, % doubled).
Environment="DEVAI_REPO=@DEVAI_REPO@"
ExecStart=/usr/bin/podman compose up -d
ExecStop=/usr/bin/podman compose down
TimeoutStartSec=600

[Install]
WantedBy=default.target
