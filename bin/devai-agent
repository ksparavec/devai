#!/usr/bin/env python3
"""devai-agent — host-side launcher for the devai lab container.

Reads user preferences from ~/.devai/preferences.yaml, runs the lab
container with the picker as entry point, and writes preferences back
on exit so the next invocation reuses the same model/agent/work-dir.

Install once via `make install` from the devai repo, then run from
anywhere on the host. The work directory mounted as
/home/devai/work is the shell's $PWD at the time of invocation —
just `cd` to the project you want to work on first.

    cd ~/myapp && devai-agent             # launch with myapp/ as work dir
    devai-agent --init                    # reset preferences to defaults
    devai-agent --cpu                     # use the CPU lab image
    devai-agent -C ~/other                # override work dir for this run
    devai-agent --model qwen3.5:9b-q8_0 --agent claude  # pre-set picks
    devai-agent --model NVIDIA-Nemotron-3-Nano-30B-A3B-NVFP4@131072 \
                --agent claude --prompt "summarize CLAUDE.md"
                                          # one-shot non-interactive call

Preferences (in ~/.devai/preferences.yaml):
    vram                int       advertised VRAM ceiling, GB
    context             int       default context cap, tokens
    last_model          str|null  most recent picker selection
    last_agent          str|null  most recent agent pick
    last_work_dir       str       record of the last directory the
                                  launcher ran from (informational —
                                  the work dir is always $PWD)
    agent_session_file  str|null  per-(agent,model) session, if supported
    gpu_vendor          str       nvidia (default) or amd -- see
                                  docs/gpu-vendors.md. This launcher does
                                  not read .env (see below), so ROCm
                                  operators set this once via
                                  --gpu-vendor amd; it then persists.

The script does NOT read the repo's .env, NOT modify the parent shell,
NOT write to the repo. Everything it touches at runtime lives under
~/.devai/. The repo is only consulted at `make install` time.
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

import yaml


# ── Paths and constants ─────────────────────────────────────────────────────

CONFIG_DIR = Path.home() / ".devai"
PREFS_FILE = CONFIG_DIR / "preferences.yaml"
PICKER_SRC = CONFIG_DIR / "model-picker.py"
# The picker imports `_capability` at module load -- bind-mounted next
# to the picker so the import resolves on the in-container PYTHONPATH.
CAPABILITY_SRC = CONFIG_DIR / "_capability.py"
SESSIONS_DIR = CONFIG_DIR / "sessions"
PICK_BACK_CHANNEL = CONFIG_DIR / ".last-pick.json"

# One probe cache per backend. The picker reads them independently —
# missing ones are tolerated (the picker just shows no rows for that
# backend). The Ollama cache is the only one required for a useful
# picker session today; vLLM and SGLang come online as their probers
# populate their caches.
PROBE_CACHES = {
    "ollama": CONFIG_DIR / ".ollama-reasoning-cache.json",
    "vllm":   CONFIG_DIR / ".vllm-reasoning-cache.json",
    "sglang": CONFIG_DIR / ".sglang-reasoning-cache.json",
}

# Bench cache feeds the picker's TPS/CODE/REAS/TOTAL columns. Mounted
# at the same /etc/devai/ prefix as the probe caches so the picker's
# _BENCH_CACHE_PATHS lookup finds it. Absent file is non-fatal — the
# picker renders the four score columns as '-' and the sort modes
# still work, just with all rows tied at no-data.
BENCH_CACHE = CONFIG_DIR / ".bench-cache.json"

DEFAULTS: dict = {
    "vram": 24,
    "context": 131072,
    "last_model": None,
    "last_agent": None,
    "last_work_dir": None,        # set by the first run; informational only
    "agent_session_file": None,
    "gpu_vendor": "nvidia",
}

# Fail-closed egress: the lab joins this INTERNAL network (no internet route)
# and reaches the outside world only through the pipelock MITM proxy. Set
# DEVAI_NO_EGRESS_LOCK=1 to fall back to the open network (UNSAFE -- no egress
# control; debugging only). See docs/pipelock.md.
DEVAI_NETWORK = "devai-lab-egress"
DEVAI_OPEN_NETWORK = "devai-net"
PIPELOCK_CONTAINER = "devai-pipelock"
PIPELOCK_PROXY = "http://devai-pipelock:8888"
# Internal hosts that must bypass the proxy (router for inference, caches).
NO_PROXY_HOSTS = "devai-router,router,apt-cache,registry-cache,ollama,localhost,127.0.0.1,::1"
OLLAMA_HOST = "http://devai-router:11434"
FALLBACK_MODEL = "qwen3.5:9b-q8_0"
CONTAINER_USER = "devai"

# Agents whose CLI accepts a session file we can persist across runs.
# Suffix is informational; current agents all use plain text/JSONL.
# When this list grows, the in-container launchers (`scripts/*-launcher.sh`)
# need matching wiring to actually pass DEVAI_SESSION_FILE through.
AGENT_SESSION_SUFFIX = {
    "claude": ".jsonl",
    "codex":  ".jsonl",
    "aider":  ".chat",
}


# ── Preferences I/O ─────────────────────────────────────────────────────────

def write_prefs(prefs: dict) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    SESSIONS_DIR.mkdir(parents=True, exist_ok=True)
    PREFS_FILE.write_text(yaml.safe_dump(prefs, sort_keys=False))


def read_prefs() -> dict:
    """Load preferences, creating defaults on first use."""
    if not PREFS_FILE.exists():
        write_prefs(DEFAULTS)
        return dict(DEFAULTS)
    raw = yaml.safe_load(PREFS_FILE.read_text()) or {}
    if not isinstance(raw, dict):
        sys.exit(f"error: {PREFS_FILE} is not a YAML mapping. "
                 f"Run `devai-agent --init` to reset.")
    merged = dict(DEFAULTS)
    merged.update(raw)
    return merged


def session_path_for(agent: str | None, model: str | None) -> str | None:
    if not agent or not model or agent not in AGENT_SESSION_SUFFIX:
        return None
    safe_model = model.replace("/", "_").replace(":", "_")
    return str(SESSIONS_DIR / f"{agent}-{safe_model}{AGENT_SESSION_SUFFIX[agent]}")


# ── Pre-flight ──────────────────────────────────────────────────────────────

def runtime_check(runtime: str, kind: str, name: str) -> bool:
    cp = subprocess.run(
        [runtime, kind, "inspect", name],
        capture_output=True, check=False,
    )
    return cp.returncode == 0


def _egress_locked() -> bool:
    """Fail-closed egress is on unless explicitly disabled for debugging."""
    return not os.environ.get("DEVAI_NO_EGRESS_LOCK")


def _pipelock_healthy(runtime: str) -> bool:
    cp = subprocess.run(
        [runtime, "inspect", "-f", "{{.State.Health.Status}}", PIPELOCK_CONTAINER],
        capture_output=True, text=True, check=False,
    )
    return cp.returncode == 0 and cp.stdout.strip() == "healthy"


def preflight(runtime: str, image: str) -> None:
    if not shutil.which(runtime):
        sys.exit(f"error: container runtime {runtime!r} not on PATH "
                 f"(set CONTAINER_RUNTIME=docker if you don't use podman)")
    if not runtime_check(runtime, "image", image):
        which = "cpu" if image.endswith("-cpu") else "gpu"
        sys.exit(f"error: image {image!r} not found.\n"
                 f"       Build it from the devai repo: `make build-{which}`.")
    net = DEVAI_NETWORK if _egress_locked() else DEVAI_OPEN_NETWORK
    if not runtime_check(runtime, "network", net):
        sys.exit(f"error: network {net!r} not found.\n"
                 f"       Start the cache services: `make cache-up`.")
    if _egress_locked() and not _pipelock_healthy(runtime):
        sys.exit("error: egress proxy 'devai-pipelock' is not healthy.\n"
                 "       The lab is network fail-closed and has no internet\n"
                 "       route except through it. Start the cache services\n"
                 "       (`make cache-up`) and bootstrap the CA once\n"
                 "       (`make pipelock-ca-init`).\n"
                 "       To bypass without egress control (UNSAFE):\n"
                 "       set DEVAI_NO_EGRESS_LOCK=1.")
    # Require at least the Ollama cache — without it the picker's first
    # screen is empty. vLLM and SGLang caches are optional.
    ollama_cache = PROBE_CACHES["ollama"]
    if not ollama_cache.exists():
        sys.exit(f"error: probe cache missing at {ollama_cache}.\n"
                 f"       Run `make install` (and `make probe` first if "
                 f"the repo's cache is empty).")


# ── Container command construction ──────────────────────────────────────────

def gpu_flags(runtime: str, cpu_only: bool, gpu_vendor: str = "nvidia") -> list[str]:
    if cpu_only:
        return []
    if "podman" in runtime:
        device = "amd.com/gpu=all" if gpu_vendor == "amd" else "nvidia.com/gpu=all"
        return ["--device", device, "--security-opt=label=disable"]
    return ["--gpus", "all"]


def network_flags() -> list[str]:
    if _egress_locked():
        # Internal net, no internet route, no host-gateway: the lab can reach
        # only pipelock + dual-homed infra. This is the fail-closed lock.
        return ["--network", DEVAI_NETWORK]
    return ["--network", DEVAI_OPEN_NETWORK,
            "--add-host=host.containers.internal:host-gateway"]


def proxy_env() -> list[str]:
    if _egress_locked():
        # Force ALL egress through pipelock; internal hosts bypass via NO_PROXY.
        out: list[str] = []
        for var in ("HTTP_PROXY", "HTTPS_PROXY"):
            out += ["-e", f"{var}={PIPELOCK_PROXY}",
                    "-e", f"{var.lower()}={PIPELOCK_PROXY}"]
        out += ["-e", f"NO_PROXY={NO_PROXY_HOSTS}",
                "-e", f"no_proxy={NO_PROXY_HOSTS}"]
        return out
    # Legacy/unsafe: pass through whatever the host has set.
    out = []
    for var in ("HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY"):
        val = os.environ.get(var)
        if val:
            out += ["-e", f"{var}={val}", "-e", f"{var.lower()}={val}"]
    return out


def user_env(runtime: str) -> list[str]:
    # Rootless podman maps container root → host UID; only docker needs the
    # entrypoint's gosu-based UID/GID remap.
    if "podman" in runtime:
        return []
    return ["-e", f"USER_ID={os.getuid()}", "-e", f"GROUP_ID={os.getgid()}"]


def devai_user_flags(runtime: str) -> list[str]:
    """Run the container as the devai user (uid 1000), mapped to the host user.

    Rootless podman needs --userns=keep-id so devai's uid 1000 maps back to the
    host uid, keeping the bind-mounted home/work dirs writable (without it, uid
    1000 → a subuid and those mounts go unwritable). Docker already drops to
    devai via the entrypoint's gosu remap (see user_env), so this is a no-op.
    """
    if "podman" not in runtime:
        return []
    return ["--userns=keep-id", "--user", "devai"]


def optional_mounts() -> list[str]:
    out: list[str] = []
    home = Path.home()
    if (home / ".gitconfig").is_file():
        out += ["-v", f"{home / '.gitconfig'}:/tmp/host-config/.gitconfig:ro"]
    if (home / ".ssh").is_dir():
        out += ["-v", f"{home / '.ssh'}:/tmp/host-config/.ssh:ro"]
    # Read-only model caches so the picker can do disk-based "is downloaded?"
    # checks. vLLM/SGLang weights live on their OWN volumes now (no longer
    # under ollama/), so each is mounted separately. Skip any that are absent.
    for host_path in (
        "/var/cache/devai/ollama",
        "/var/cache/devai/vllm",
        "/var/cache/devai/sglang",
    ):
        if Path(host_path).is_dir():
            out += ["-v", f"{host_path}:{host_path}:ro"]
    return out


def build_run_cmd(
    *, runtime: str, image: str, cpu_only: bool,
    work_dir: Path, prefs: dict,
    pref_model: str | None, pref_agent: str | None,
    gpu_vendor: str = "nvidia",
    prompt: str | None = None,
) -> list[str]:
    home_volume = Path(os.environ.get("HOME_VOLUME", str(Path.home() / "devai-home")))
    home_volume.mkdir(parents=True, exist_ok=True)

    pref_session = session_path_for(pref_agent, pref_model)

    # Non-interactive runs (--prompt) drop the TTY: stdout must be captureable
    # by the caller and there is no human at the other end of stdin.
    cmd: list[str] = [runtime, "run", "--rm"]
    if prompt is None:
        cmd += ["-i", "-t"]

    cmd += devai_user_flags(runtime)

    cmd += [
        *gpu_flags(runtime, cpu_only, gpu_vendor),
        *network_flags(),
        *proxy_env(),
        "-e", f"OLLAMA_HOST={OLLAMA_HOST}",
        "-e", f"OLLAMA_DEFAULT_MODEL={pref_model or FALLBACK_MODEL}",
        "-e", f"CONTEXT={prefs['context']}",
        "-e", f"VRAM={prefs['vram']}",
        "-e", f"CONTAINER_USER={CONTAINER_USER}",
        # Point the picker at the vLLM/SGLang volumes (mounted by
        # optional_mounts). Overrides the baked image default, which still
        # points at the retired ollama/models/vllm path.
        "-e", "VLLM_MODELS_DIR=/var/cache/devai/vllm",
        "-e", "SGLANG_MODELS_DIR=/var/cache/devai/sglang",
    ]

    if prompt is not None:
        # The in-container picker (scripts/model-picker.py) reads this
        # env var; when set together with DEVAI_PREF_MODEL/DEVAI_PREF_AGENT
        # it bypasses the fzf UI and execs the agent in one-shot mode.
        cmd += ["-e", f"DEVAI_NONINTERACTIVE_PROMPT={prompt}"]

    # Surface preferences to the picker so future versions can pre-select.
    # Today's picker doesn't read these but the env contract is forward-stable.
    if pref_model:
        cmd += ["-e", f"DEVAI_PREF_MODEL={pref_model}"]
    if pref_agent:
        cmd += ["-e", f"DEVAI_PREF_AGENT={pref_agent}"]
    if pref_session:
        # In-container path; the launcher mounts ~/.devai → /devai-host.
        cmd += ["-e", f"DEVAI_SESSION_FILE=/devai-host/sessions/"
                f"{Path(pref_session).name}"]

    cmd += [*user_env(runtime)]

    # Persistent home for the devai user inside the container.
    cmd += ["-v", f"{home_volume}:/home/{CONTAINER_USER}"]

    # ~/.devai/ → /devai-host (rw). The picker drops .last-pick.json here on
    # exit so we can update preferences after the container ends.
    cmd += ["-v", f"{CONFIG_DIR}:/devai-host"]

    # Probe caches — the picker and router expect /etc/devai/<name>.json.
    # Mount whatever exists; absent backend caches are tolerated downstream.
    for backend, host_path in PROBE_CACHES.items():
        if host_path.exists():
            cmd += ["-v",
                    f"{host_path}:/etc/devai/.{backend}-reasoning-cache.json:ro"]

    # Bench cache — same /etc/devai/ prefix the picker scans. Without
    # this mount the four bench-score columns show '-' even when the
    # repo's deploy/.bench-cache.json is fully populated.
    if BENCH_CACHE.exists():
        cmd += ["-v", f"{BENCH_CACHE}:/etc/devai/.bench-cache.json:ro"]

    # Override the baked-in /usr/local/bin/model-picker with the host copy
    # so improvements made in the repo (and copied to ~/.devai/ by
    # `make install`) take effect without an image rebuild.
    if PICKER_SRC.is_file():
        cmd += ["-v", f"{PICKER_SRC}:/usr/local/bin/model-picker:ro"]
    # Same for the Capability constants module the picker imports.
    if CAPABILITY_SRC.is_file():
        cmd += ["-v", f"{CAPABILITY_SRC}:/usr/local/bin/_capability.py:ro"]

    cmd += [*optional_mounts()]

    # The user-chosen working directory.
    cmd += ["-v", f"{work_dir}:/home/{CONTAINER_USER}/work"]

    cmd += [image, "agent-picker"]
    return cmd


# ── Main ────────────────────────────────────────────────────────────────────

def make_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        prog="devai-agent",
        description="Standalone launcher for the devai lab container.",
    )
    ap.add_argument("--init", action="store_true",
                    help="reset ~/.devai/preferences.yaml to defaults and exit")
    ap.add_argument("--cpu", action="store_true",
                    help="use the CPU lab image instead of GPU")
    ap.add_argument("--gpu-vendor", choices=("nvidia", "amd"),
                    help="override gpu_vendor for this run "
                         "(persisted to preferences on exit; see "
                         "docs/gpu-vendors.md)")
    ap.add_argument("-C", "--workdir",
                    help="mount this directory as /home/devai/work "
                         "instead of the current $PWD "
                         "(persisted to last_work_dir on exit)")
    ap.add_argument("--model",
                    help="override last_model for this run "
                         "(persisted to preferences on exit)")
    ap.add_argument("--agent",
                    help="override last_agent for this run "
                         "(persisted to preferences on exit)")
    ap.add_argument("--show", action="store_true",
                    help="print the resolved preferences and the "
                         "container command, do not run")
    ap.add_argument("--prompt",
                    help="run the chosen agent non-interactively with "
                         "this one-shot prompt and exit. Requires --model "
                         "and --agent (currently --agent claude only). "
                         "Stdin is not used; the prompt is delivered via "
                         "DEVAI_NONINTERACTIVE_PROMPT inside the container.")
    return ap


def main() -> int:
    args = make_parser().parse_args()

    if args.init:
        write_prefs(DEFAULTS)
        print(f"reset {PREFS_FILE} to defaults.")
        return 0

    if args.prompt is not None and (not args.model or not args.agent):
        sys.exit("error: --prompt requires both --model and --agent "
                 "(non-interactive mode cannot consult the picker).")

    prefs = read_prefs()

    runtime = os.environ.get("CONTAINER_RUNTIME", "podman")
    image = "devai-lab-cpu" if args.cpu else "devai-lab-gpu"

    # Work dir defaults to the current shell's $PWD, NOT to prefs.last_work_dir.
    # `last_work_dir` is a record of where the user last ran from (kept for
    # display / scripting), not a sticky default. The user expects
    # `cd ~/projects/foo && devai-agent` to mount foo at /home/devai/work.
    work_dir = Path(args.workdir or os.getcwd()).expanduser().resolve()
    if not work_dir.is_dir():
        sys.exit(f"error: work_dir {work_dir} is not an existing directory.\n"
                 f"       Pass --workdir <path> or `cd` to a real directory.")

    pref_model = args.model or prefs.get("last_model")
    pref_agent = args.agent or prefs.get("last_agent")
    pref_gpu_vendor = args.gpu_vendor or prefs.get("gpu_vendor", "nvidia")

    preflight(runtime, image)

    cmd = build_run_cmd(
        runtime=runtime, image=image, cpu_only=args.cpu,
        work_dir=work_dir, prefs=prefs,
        pref_model=pref_model, pref_agent=pref_agent,
        gpu_vendor=pref_gpu_vendor,
        prompt=args.prompt,
    )

    if args.show:
        print(yaml.safe_dump(prefs, sort_keys=False))
        print("# container command:")
        print(" \\\n  ".join(cmd))
        return 0

    # Clear stale pick file before running so we only see this run's choice.
    try:
        PICK_BACK_CHANNEL.unlink()
    except FileNotFoundError:
        pass

    # No timeout: this is an interactive container session (lab + picker
    # TUI + agent CLI). The user may legitimately leave it open for
    # hours. Ctrl-C in the parent shell or SIGTERM from a supervisor
    # is the intended stop mechanism. Don't switch to subprocess.run
    # with timeout= here without also wiring a way for the user to
    # extend the budget interactively.
    rc = subprocess.call(cmd)

    # Update preferences from this run.
    new_prefs = dict(prefs)
    new_prefs["last_work_dir"] = str(work_dir)
    new_prefs["gpu_vendor"] = pref_gpu_vendor

    pick: dict = {}
    if PICK_BACK_CHANNEL.exists():
        try:
            pick = json.loads(PICK_BACK_CHANNEL.read_text()) or {}
        except (OSError, json.JSONDecodeError) as exc:
            print(f"warning: ignoring corrupt {PICK_BACK_CHANNEL.name} ({exc})",
                  file=sys.stderr)
        finally:
            try:
                PICK_BACK_CHANNEL.unlink()
            except FileNotFoundError:
                pass

    chosen_model = args.model or pick.get("model") or prefs.get("last_model")
    chosen_agent = args.agent or pick.get("agent") or prefs.get("last_agent")
    new_prefs["last_model"] = chosen_model
    new_prefs["last_agent"] = chosen_agent
    new_prefs["agent_session_file"] = session_path_for(chosen_agent, chosen_model)
    if pick.get("context"):
        new_prefs["context"] = int(pick["context"])

    write_prefs(new_prefs)
    return rc


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
