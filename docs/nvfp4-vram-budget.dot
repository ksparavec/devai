// Realistic VRAM budget for nvidia/Qwen3-8B-NVFP4 at four context
// lengths (1 K = 1 024 tokens). Byte counts in the columns are derived
// (decimal GB) and checked against vLLM's own memory lines.
//
// Source of truth:
//   - measured (vLLM log, 3 launches 2026-07-16..19, ctx 32768, v0.22.1;
//     scripts/stats/perf_phases.py): weights loaded 5.98 GiB (checkpoint
//     5.96 GiB), KV pool 13.73 GiB = 199 984 tokens at
//     --gpu-memory-utilization 0.92, CUDA graph pool 0.16 GiB at
//     --max-num-seqs 32
//   - analytical: HF config.json for Qwen3-8B
//       36 layers, 8 KV heads (GQA), head_dim 128, vocab 151936,
//       hidden 4096, quant_algo=NVFP4 (group_size 16),
//       kv_cache_scheme = FP8 (1 byte/elem), untied embed_tokens and
//       lm_head (both BF16)
//
// As delivered the checkpoint serves at most 32 K (position limit
// 40 960); the 64 K / 128 K / 256 K columns are arithmetic only.
//
// Each column is a vertical stack; cell HEIGHT is roughly proportional
// to bytes within a column. The numbers shown are the MIN required (what
// the runtime would allocate without the elastic KV pool).
//
// Render: dot -Tsvg nvfp4-vram-budget.dot -o nvfp4-vram-budget.svg

digraph nvfp4_vram {
  rankdir=LR;
  fontname="Helvetica";
  nodesep=0.6;
  ranksep=0.4;
  graph [fontsize=20, labelloc=t,
         label=<<B>NVFP4 VRAM budget -- nvidia/Qwen3-8B-NVFP4</B><BR/><FONT POINT-SIZE="14">minimum required per component, by context length (KV cache stored in FP8; derived, decimal GB)</FONT><BR/><FONT POINT-SIZE="11">measured (vLLM log, 2026-07, ctx 32768): weights 5.98 GiB, KV pool 13.73 GiB, graph pool 0.16 GiB . serves 32 K as delivered; larger columns hypothetical</FONT>>];
  node [shape=plaintext, fontname="Helvetica", fontsize=14];
  edge [style=invis];

  ref [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="14">
      <TR><TD BGCOLOR="#333333"><FONT COLOR="white" POINT-SIZE="16"><B>Component</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#FFFBEA" ALIGN="LEFT"><FONT POINT-SIZE="14">Free / KV elastic pool</FONT><BR/><FONT POINT-SIZE="11">vLLM/SGLang fill to --gpu-memory-utilization</FONT></TD></TR>
      <TR><TD BGCOLOR="#E1F5E1" ALIGN="LEFT"><FONT POINT-SIZE="14">CUDA graphs</FONT><BR/><FONT POINT-SIZE="11">batch sizes up to --max-num-seqs (32): 0.16 GiB measured</FONT></TD></TR>
      <TR><TD BGCOLOR="#FFE0E0" ALIGN="LEFT"><FONT POINT-SIZE="14">Activations + workspace</FONT><BR/><FONT POINT-SIZE="11">cuBLAS, attention scratch (estimate)</FONT></TD></TR>
      <TR><TD BGCOLOR="#FFC4C4" ALIGN="LEFT"><FONT POINT-SIZE="14">Runtime overhead</FONT><BR/><FONT POINT-SIZE="11">CUDA ctx, allocator slack (estimate)</FONT></TD></TR>
      <TR><TD BGCOLOR="#D6E4FF" ALIGN="LEFT"><FONT POINT-SIZE="14">KV cache (FP8, paged)</FONT><BR/><FONT POINT-SIZE="11">2*L*H_kv*d*1B per token = 72 KiB/tok</FONT></TD></TR>
      <TR><TD BGCOLOR="#BFD4FF" ALIGN="LEFT"><FONT POINT-SIZE="14">embed_tokens + lm_head (BF16)</FONT><BR/><FONT POINT-SIZE="11">2 x 151 936 x 4 096 x 2 B (untied)</FONT></TD></TR>
      <TR><TD BGCOLOR="#7FA8E8"><FONT COLOR="white" POINT-SIZE="14"><B>NVFP4 weights</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="11">~6.95 B params x 0.5625 B/param</FONT></TD></TR>
    </TABLE>
  >];

  c0 [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10">
      <TR><TD BGCOLOR="#333333"><FONT COLOR="white" POINT-SIZE="16"><B>32 K ctx</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="11">served as delivered</FONT></TD></TR>
      <TR><TD BGCOLOR="#FFFBEA" HEIGHT="28" ALIGN="RIGHT"><FONT POINT-SIZE="13">elastic ...</FONT></TD></TR>
      <TR><TD BGCOLOR="#E1F5E1" HEIGHT="12" ALIGN="RIGHT"><FONT POINT-SIZE="12">0.2 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#FFE0E0" HEIGHT="28" ALIGN="RIGHT"><FONT POINT-SIZE="14">1.0 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#FFC4C4" HEIGHT="28" ALIGN="RIGHT"><FONT POINT-SIZE="14">1.0 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#D6E4FF" HEIGHT="60" ALIGN="RIGHT"><FONT POINT-SIZE="14">2.4 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#BFD4FF" HEIGHT="63" ALIGN="RIGHT"><FONT POINT-SIZE="14">2.5 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#7FA8E8" HEIGHT="98" ALIGN="RIGHT"><FONT COLOR="white" POINT-SIZE="14"><B>3.9 GB</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#222222"><FONT COLOR="white" POINT-SIZE="15"><B>min ~ 11.0 GB</B></FONT></TD></TR>
    </TABLE>
  >];

  c1 [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10">
      <TR><TD BGCOLOR="#333333"><FONT COLOR="white" POINT-SIZE="16"><B>64 K ctx</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="11">hypothetical for this model</FONT></TD></TR>
      <TR><TD BGCOLOR="#FFFBEA" HEIGHT="28" ALIGN="RIGHT"><FONT POINT-SIZE="13">elastic ...</FONT></TD></TR>
      <TR><TD BGCOLOR="#E1F5E1" HEIGHT="12" ALIGN="RIGHT"><FONT POINT-SIZE="12">0.2 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#FFE0E0" HEIGHT="28" ALIGN="RIGHT"><FONT POINT-SIZE="14">1.0 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#FFC4C4" HEIGHT="28" ALIGN="RIGHT"><FONT POINT-SIZE="14">1.0 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#D6E4FF" HEIGHT="120" ALIGN="RIGHT"><FONT POINT-SIZE="14">4.8 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#BFD4FF" HEIGHT="63" ALIGN="RIGHT"><FONT POINT-SIZE="14">2.5 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#7FA8E8" HEIGHT="98" ALIGN="RIGHT"><FONT COLOR="white" POINT-SIZE="14"><B>3.9 GB</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#222222"><FONT COLOR="white" POINT-SIZE="15"><B>min ~ 13.4 GB</B></FONT></TD></TR>
    </TABLE>
  >];

  c2 [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10">
      <TR><TD BGCOLOR="#333333"><FONT COLOR="white" POINT-SIZE="16"><B>128 K ctx</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="11">hypothetical for this model</FONT></TD></TR>
      <TR><TD BGCOLOR="#FFFBEA" HEIGHT="28" ALIGN="RIGHT"><FONT POINT-SIZE="13">elastic ...</FONT></TD></TR>
      <TR><TD BGCOLOR="#E1F5E1" HEIGHT="12" ALIGN="RIGHT"><FONT POINT-SIZE="12">0.2 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#FFE0E0" HEIGHT="31" ALIGN="RIGHT"><FONT POINT-SIZE="14">1.2 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#FFC4C4" HEIGHT="28" ALIGN="RIGHT"><FONT POINT-SIZE="14">1.0 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#D6E4FF" HEIGHT="242" ALIGN="RIGHT"><FONT POINT-SIZE="14">9.7 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#BFD4FF" HEIGHT="63" ALIGN="RIGHT"><FONT POINT-SIZE="14">2.5 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#7FA8E8" HEIGHT="98" ALIGN="RIGHT"><FONT COLOR="white" POINT-SIZE="14"><B>3.9 GB</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#222222"><FONT COLOR="white" POINT-SIZE="15"><B>min ~ 18.5 GB</B></FONT></TD></TR>
    </TABLE>
  >];

  c3 [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10">
      <TR><TD BGCOLOR="#333333"><FONT COLOR="white" POINT-SIZE="16"><B>256 K ctx</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="11">hypothetical; exceeds 24 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#FFFBEA" HEIGHT="28" ALIGN="RIGHT"><FONT POINT-SIZE="13">elastic ...</FONT></TD></TR>
      <TR><TD BGCOLOR="#E1F5E1" HEIGHT="12" ALIGN="RIGHT"><FONT POINT-SIZE="12">0.2 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#FFE0E0" HEIGHT="39" ALIGN="RIGHT"><FONT POINT-SIZE="14">1.5 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#FFC4C4" HEIGHT="28" ALIGN="RIGHT"><FONT POINT-SIZE="14">1.0 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#D6E4FF" HEIGHT="482" ALIGN="RIGHT"><FONT POINT-SIZE="14">19.3 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#BFD4FF" HEIGHT="63" ALIGN="RIGHT"><FONT POINT-SIZE="14">2.5 GB</FONT></TD></TR>
      <TR><TD BGCOLOR="#7FA8E8" HEIGHT="98" ALIGN="RIGHT"><FONT COLOR="white" POINT-SIZE="14"><B>3.9 GB</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#222222"><FONT COLOR="white" POINT-SIZE="15"><B>min ~ 28.4 GB</B></FONT></TD></TR>
    </TABLE>
  >];

  ref -> c0 -> c1 -> c2 -> c3;
}
