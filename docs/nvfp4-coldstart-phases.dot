// NVFP4 cold-start phase timeline for vLLM / SGLang on a Blackwell GPU.
// Vertical (top-to-bottom) layout so the diagram fits a page width
// without text shrinking below readable size.
//
// Each phase node names what is happening and what limits it. The phase
// order follows vLLM's own log lines. Measured times (vLLM log + router
// log, scripts/stats/perf_phases.py) are given for groups of phases, for
// nvidia/Qwen3-8B-NVFP4 (3 launches, 2026-07-16..19, ctx 32768, vLLM
// v0.22.1, --max-num-seqs 32) on the RTX PRO 4000 Blackwell (24 GB GDDR7).
// See docs/nvfp4-coldstart.md Sec. 1 for the 27B builds and the method.
//
// Render: dot -Tsvg nvfp4-coldstart-phases.dot -o nvfp4-coldstart-phases.svg

digraph nvfp4_coldstart {
  rankdir=TB;
  fontname="Helvetica";
  ranksep=0.45;
  nodesep=0.4;
  node [shape=box, style="rounded,filled", fontname="Helvetica",
        fontsize=14, margin="0.30,0.18", penwidth=1.5];
  edge [fontname="Helvetica", fontsize=12, color="#555555", penwidth=1.4];
  graph [fontsize=18, labelloc=t,
         label=<<B>NVFP4 cold-start phase timeline</B><BR/><FONT POINT-SIZE="13">nvidia/Qwen3-8B-NVFP4 . RTX PRO 4000 Blackwell (24 GB GDDR7) . vLLM v0.22.1</FONT><BR/><FONT POINT-SIZE="11">phase order from vLLM's log; measured times for groups of phases (3 launches, 2026-07)</FONT>>];

  // Legend strip across the top.
  subgraph cluster_legend {
    label="Resource legend"; style=dashed; color="#999999"; fontsize=13;
    rank=same;
    L1 [label="CPU / disk / RAM",         fillcolor="#E8F1FF", color="#4A78C2"];
    L2 [label="host -> GPU weight copy",  fillcolor="#FFF1D6", color="#C28A2A"];
    L3 [label="VRAM allocation",          fillcolor="#FFE0E0", color="#C24A4A"];
    L4 [label="GPU compute (kernel/JIT)", fillcolor="#E1F5E1", color="#3D8A3D"];
    L1 -> L2 [style=invis];
    L2 -> L3 [style=invis];
    L3 -> L4 [style=invis];
  }

  P0  [label="0. Router decision\nstop other backend, remove placeholder",
       fillcolor="#E8F1FF", color="#4A78C2"];
  P1  [label="1. Container start\nimage layers, cgroups, devices, entrypoint",
       fillcolor="#E8F1FF", color="#4A78C2"];
  P2  [label="2. Python + library import\nvllm / sglang, torch, flashinfer, cutlass\n(phases 0-2: 7-18 s)",
       fillcolor="#E8F1FF", color="#4A78C2"];
  P3  [label="3. API server + engine-core start\nparse config.json + quantization_config, tokenizer,\nspawn engine process (14 s)",
       fillcolor="#E8F1FF", color="#4A78C2"];
  P4  [label="4. CUDA context init\ndriver handshake, primary ctx, cuBLAS handles",
       fillcolor="#FFE0E0", color="#C24A4A"];
  P5  [label="5. Weight mmap + shard views\n(5.96 GiB checkpoint)",
       fillcolor="#E8F1FF", color="#4A78C2"];
  P6  [label="6. Weight copy to GPU\nNVFP4 tensors + FP8 scales + two BF16 vocabulary matrices\nweights 1.5-1.6 s for 5.98 GiB: not PCIe-bound",
       fillcolor="#FFF1D6", color="#C28A2A"];
  P7  [label="7. Weight registration\ncutlass NVFP4 GEMM operands, per-block scales (+ MTP head if on)\n(phases 4-7: 2-3 s)",
       fillcolor="#FFE0E0", color="#C24A4A"];
  P8  [label="8. Profiling run (first forward pass)\ntorch.compile of the model graph (15 s), FlashInfer / NVFP4 kernel JIT,\npeak activation measured",
       fillcolor="#E1F5E1", color="#3D8A3D"];
  P9  [label="9. KV cache pool sizing + allocation\n--gpu-memory-utilization x device memory minus profiled use\n(13.73 GiB = 199 984 tokens)",
       fillcolor="#FFE0E0", color="#C24A4A"];
  P10 [label="10. NVFP4 GEMM autotune + CUDA graph capture\nbatch sizes up to --max-num-seqs (32): 11 piecewise up to 64, 7 full up to 32\n(capture 1 s, 0.16 GiB; with MTP, K+1 tokens per sequence per step)\n(phases 8-10 = vLLM init engine: 30 s)",
       fillcolor="#E1F5E1", color="#3D8A3D"];
  P11 [label="11. /health -> 200\nrouter polls every 2 s, then proxies the queued request (2 s)",
       fillcolor="#D6F5D6", color="#2F6F2F", penwidth=2];

  P0 -> P1 -> P2 -> P3 -> P4 -> P5 -> P6 -> P7 -> P8 -> P9 -> P10 -> P11;

  N_recreate [shape=note, fillcolor="#FFFBEA", color="#B89B3A", fontsize=12,
              label="Triggers a full recreate (phases 1-11):\n* model change\n* @ctx change -> --max-model-len\n* MTP on/off change (::mtp / ::nomtp)\n(a ::reasoning override does NOT recreate)"];

  N_measured [shape=note, fillcolor="#E8F5E8", color="#3D8A3D", fontsize=13,
              label=<<B>Measured, Qwen3-8B-NVFP4</B><BR ALIGN="LEFT"/>router launch -&gt; ready: 55-67 s<BR ALIGN="LEFT"/>(3 launches, 2026-07, ctx 32768)<BR ALIGN="LEFT"/>median 44.5 s on the 2026-04/05 image<BR ALIGN="LEFT"/>(16 launches)<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">Sources: router + vLLM logs,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">scripts/stats/perf_phases.py, perf_coldstart.py</FONT><BR ALIGN="LEFT"/>>];

  N_router [shape=note, fillcolor="#FFFBEA", color="#B89B3A", fontsize=12,
            label="Router timeout:\nHEALTH_TIMEOUT_SECONDS=600\n(engineering margin; slowest observed\nsuccessful launch 278 s, slower ones\ntimed out or were abandoned)"];

  P0  -> N_recreate [style=dashed, arrowhead=none, constraint=false];
  P9  -> N_measured [style=dashed, arrowhead=none, constraint=false];
  P11 -> N_router   [style=dashed, arrowhead=none, constraint=false];

  {rank=same; P0;  N_recreate;}
  {rank=same; P9;  N_measured;}
  {rank=same; P11; N_router;}
}
