# Proxy settings (used during both build and runtime)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,host.containers.internal

# Build cache (start with: make cache-up)
# APT_PROXY=http://localhost:3142

# Container settings
CONTAINER_USER=devai
IMAGE_NAME=devai-lab
PORT=8888
CONTAINER_RUNTIME=podman
HOST_WORK_DIR=.
HOST_HOME_DIR=
# HOME_VOLUME=devai-lab-home

# Ollama settings (for local model inference)
# Run Ollama on host: ollama serve
# Default connects to host machine's Ollama instance
OLLAMA_HOST=http://host.containers.internal:11434
