# Proxy settings (used during both build and runtime)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,host.containers.internal

# Build cache (start with: make cache-up)
# APT_PROXY=http://localhost:3142

# Container settings
# NOTE: .env is parsed by Make, not the shell. Use $(HOME) instead of $HOME.
LAB_PORT=8888
WEBUI_PORT=8443
CONTAINER_RUNTIME=podman
HOST_WORK_DIR=.
HOST_HOME_DIR=$(HOME)
HOME_VOLUME=$(HOME)/devai-home
# JUPYTER_TOKEN=<generate-your-own>

# GPU inference settings
# GPU_MEMORY_GB=24
# MAX_CONTEXT_LEN=262144
# DEVAI_REASONING accepts: auto|off|low|medium|high
# DEVAI_REASONING=auto

# Router lifecycle / limits (see docs/router.md)
# IDLE_TIMEOUT: seconds before an idle model is auto-unloaded; 0 = never (keep-warm)
# IDLE_TIMEOUT=0
# HEALTH_TIMEOUT_SECONDS: max wait for a backend to become healthy after launch
# (crashed engines fail fast regardless; this only bounds a slow-healthy load)
# HEALTH_TIMEOUT_SECONDS=600
# MAX_CONCURRENT_REQUESTS: in-flight requests per backend before HTTP 429; 0 = unlimited
# MAX_CONCURRENT_REQUESTS=32

# GPU vendor (see docs/gpu-vendors.md). Set via `make gpu-vendor VENDOR=nvidia|amd`
# rather than editing these directly -- devai-tools/cmd/devai-gpu-vendor keeps
# the 4 vars below in lockstep. NVIDIA is the default; devai is fully verified
# on NVIDIA only, AMD/ROCm is build-time-verified only (no ROCm hardware
# tested yet).
# DEVAI_GPU_VENDOR=nvidia
# DEVAI_GPU_DEVICE=nvidia.com/gpu=all
# VLLM_IMAGE=docker.io/vllm/vllm-openai:v0.22.1-x86_64-cu129-ubuntu2404
# SGLANG_IMAGE=docker.io/lmsysorg/sglang:v0.5.10.post1-cu130

# --- NVFP4 quantization (make quant-local / quant-cloud; see scripts/quant/) --
# Generic + config-driven. Uncomment + set to override the Makefile defaults;
# the ladder (smoke -> 9B -> 35B) is just an edit here.
# QUANT_MODEL=Qwen/Qwen2.5-1.5B-Instruct   # source bf16: HF repo id OR a local path under the vLLM models dir
# QUANT_PRESET=dense                        # dense (ignore lm_head) | ornith (keep MoE gates / vision tower / linear-attn in bf16; use for both Ornith 9B + 35B -- they are multimodal)
# QUANT_SCHEME=NVFP4                         # NVFP4 (W4A4) | NVFP4A16 (weight-only; less loss, ~same VRAM)
# QUANT_CALIB_SAMPLES=128                    # 512 for real runs
# QUANT_MAX_SEQ=512
# QUANT_DATASET=open_platypus               # an llm-compressor registered calibration dataset
# QUANT_SERVE=transformers                   # in-run reload/validate backend: transformers (keep -- llmcompressor + vLLM clash in one env)
# QUANT_MOE_ALL_EXPERTS=0                    # 1 for MoE (calibrate every expert)
# QUANT_OUT_NAME=                            # local: save NVFP4 under VLLM_MODELS_DIR/<name> (empty = scratch, not kept)
# QUANT_PUSH_REPO=                           # optional HF repo id to push the NVFP4 checkpoint to (empty = no push)
# QUANT_IMAGE=docker.io/vllm/vllm-openai:v0.22.1-x86_64-cu129-ubuntu2404
# QUANT_FLAVOR=rtx-pro-6000                  # HF Jobs GPU flavor (quant-cloud)
# QUANT_TIMEOUT=1h                           # HF Jobs timeout (quant-cloud); use 4h for the 35B
# Ladder examples (set here, then `make quant-local` or `make quant-cloud`):
#   smoke : QUANT_MODEL=Qwen/Qwen2.5-1.5B-Instruct
#   9B    : QUANT_MODEL=deepreinforce-ai/Ornith-1.0-9B   QUANT_PRESET=ornith  QUANT_OUT_NAME=Ornith-1.0-9B-NVFP4  QUANT_CALIB_SAMPLES=512  QUANT_SERVE=none
#   35B   : QUANT_MODEL=deepreinforce-ai/Ornith-1.0-35B  QUANT_PRESET=ornith  QUANT_MOE_ALL_EXPERTS=1  QUANT_CALIB_SAMPLES=512  QUANT_SERVE=none  QUANT_PUSH_REPO=<you>/Ornith-1.0-35B-NVFP4
