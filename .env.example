# Proxy settings (used during both build and runtime)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,host.containers.internal

# Build cache (start with: make cache-up)
# APT_PROXY=http://localhost:3142

# Container settings
# NOTE: .env is parsed by Make, not the shell. Use $(HOME) instead of $HOME.
LAB_PORT=8888
WEBUI_PORT=8443
CONTAINER_RUNTIME=podman
HOST_WORK_DIR=.
HOST_HOME_DIR=$(HOME)
HOME_VOLUME=$(HOME)/devai-home
# JUPYTER_TOKEN=<generate-your-own>

